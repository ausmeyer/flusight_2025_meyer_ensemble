library(dplyr)
library(readr)
library(lubridate)
library(tidyr)
library(ggplot2)
library(knitr)
library(DT)
# 1. Load Actuals (Truth Data)
latest_file <- function(dir, pattern) {
files <- list.files(dir, pattern = pattern, full.names = TRUE)
if (length(files) == 0) return(NA_character_)
files[order(files)][length(files)]
}
# Determine root path prefix based on where script is running
if (dir.exists('../data/imputed_sets')) {
root_prefix <- '..'
} else if (dir.exists('data/imputed_sets')) {
root_prefix <- '.'
} else {
stop("Could not locate data/imputed_sets/ directory relative to current WD: ", getwd())
}
data_dir <- file.path(root_prefix, 'data/imputed_sets')
actual_path <- latest_file(data_dir, '^imputed_and_stitched_hosp_.*\\\\.csv$')
if(is.na(actual_path)) stop("No stitched data found in ", data_dir)
install.packages('flexdash')
install.packages('flexdashboard')
